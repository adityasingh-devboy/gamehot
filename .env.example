# =================================================================
# COUPLEVERSE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local on your VPS and fill in values.
# NEVER commit .env or real credentials to GitHub.
# =================================================================

# Server Port & Mode
PORT=3000
NODE_ENV=production

# Optional Supabase Database & Auth Integration
# If left blank, CoupleVerse operates in zero-config guest & in-memory session mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
